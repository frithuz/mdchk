{
  "concurrency": 3,
  "max_rounds": 3,
  "base_branch": "main",
  "merge_method": "rebase",
  "labels": {
    "queue": "factory",
    "needs_info": "factory:needs-info",
    "needs_human": "factory:needs-human"
  },
  "routing": {
    "low":    { "code": "haiku",  "qa-review": "haiku" },
    "medium": { "code": "sonnet", "qa-review": "sonnet" },
    "high":   { "code": "sonnet", "qa-review": "sonnet", "change-impact": "sonnet" }
  },
  "surface_reviewers": {
    "ui": { "interface-review": "sonnet" },
    "security": { "security-review": "opus" },
    "fix": { "fix-review": "sonnet" },
    "contract": { "contract-review": "sonnet", "change-impact": "sonnet" },
    "perf": { "performance-review": "sonnet" },
    "windows": { "windows-review": "sonnet" },
    "macos": { "macos-review": "sonnet" }
  },
  "specialist_reviewers": [
    "change-impact", "contract-review", "fix-review", "interface-review",
    "performance-review", "qa-review", "security-review", "windows-review",
    "macos-review"
  ],
  "protected_paths": [
    "factory/checks.sh",
    "factory/config.json"
  ],
  "ports": { "base": 5100, "step": 10 },
  "prices_usd_per_mtok": {
    "claude-fable-5-1":  { "input": 10.0, "output": 50.0, "cache_write_5m": 12.5, "cache_write_1h": 20.0, "cache_read": 0.25 },
    "claude-opus-5-5":   { "input": 4.0,  "output": 20.0, "cache_write_5m": 5.0,  "cache_write_1h": 8.0,  "cache_read": 0.20 },
    "claude-sonnet-5-5": { "input": 2.0,  "output": 10.0, "cache_write_5m": 2.5,  "cache_write_1h": 4.0,  "cache_read": 0.20 },
    "claude-haiku-5-5":  { "input": 0.10, "output": 0.50, "cache_write_5m": 0.125, "cache_write_1h": 0.20, "cache_read": 0.01 }
  }
}
